@model Test4AConsulting.MVC.Models.Book

<h1>Редактирование книги</h1>

<form asp-action="Edit" method="post">

    <input asp-for="Id" type="hidden" />

    <div class="mb-3">
        <label asp-for="Title" class="form-label">Название</label>
        <input asp-for="Title" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Author" class="form-label">Автор</label>
        <input asp-for="Author" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="PublicationYear" class="form-label">Год издания</label>
        <input asp-for="PublicationYear" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Publisher" class="form-label">Издательство</label>
        <input asp-for="Publisher" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Isbn" class="form-label">ISBN</label>
        <input asp-for="Isbn" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">Описание</label>
        <textarea asp-for="Description"
                  class="form-control"
                  rows="4"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Contents" class="form-label">
            Оглавление
        </label>

        <textarea asp-for="Contents"
                  id="contentsEditor"
                  class="form-control"
                  rows="15">
        </textarea>

        <span asp-validation-for="Contents"
            class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Сохранить
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Отмена
    </a>

</form>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/tinymce@7/tinymce.min.js"></script>

    <script>
        tinymce.init({
            selector: '#contentsEditor',
            height: 400,
            menubar: false,
            plugins: 'lists link code',
            toolbar: 'undo redo | bold italic | bullist numlist | link | code'
        });
    </script>
}
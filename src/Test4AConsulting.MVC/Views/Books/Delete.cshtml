@model Test4AConsulting.MVC.Models.Book

<h1>Удаление книги</h1>

<div class="alert alert-warning">
    Вы действительно хотите удалить эту книгу?
</div>

<dl class="row">
    <dt class="col-sm-2">Название</dt>
    <dd class="col-sm-10">@Model.Title</dd>

    <dt class="col-sm-2">Автор</dt>
    <dd class="col-sm-10">@Model.Author</dd>

    <dt class="col-sm-2">Год</dt>
    <dd class="col-sm-10">@Model.PublicationYear</dd>
</dl>

<form asp-action="Delete" method="post">

    <input type="hidden" asp-for="Id" />

    <button type="submit"
            class="btn btn-danger">
        Удалить
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Отмена
    </a>

</form>